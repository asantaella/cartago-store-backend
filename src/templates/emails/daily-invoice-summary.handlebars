<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Resumen diario de pedidos – {{date}}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f5f5f5;
        color: #333;
        line-height: 1.5;
      }
      .container {
        max-width: 1024px;
        margin: 24px auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      }
      .header {
        background-color: #1c1c1e;
        color: #ffffff;
        padding: 24px 32px;
      }
      .header h1 {
        font-size: 20px;
        font-weight: 600;
      }
      .header p {
        font-size: 13px;
        color: #aaaaaa;
        margin-top: 4px;
      }
      .summary-bar {
        background-color: #f0f0f0;
        padding: 14px 32px;
        font-size: 13px;
        color: #555;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
      }
      .summary-bar strong {
        color: #1c1c1e;
      }
      .summary-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .summary-item-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #777;
      }
      .summary-item-value {
        font-size: 15px;
        font-weight: 700;
        color: #1c1c1e;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
      }
      thead tr {
        background-color: #f7f7f7;
        border-bottom: 2px solid #e0e0e0;
      }
      thead th {
        text-align: left;
        padding: 10px 12px;
        font-weight: 600;
        color: #555;
        white-space: nowrap;
      }
      tbody tr {
        border-bottom: 1px solid #f0f0f0;
      }
      tbody tr:last-child {
        border-bottom: none;
      }
      tbody td {
        padding: 10px 12px;
        color: #333;
        vertical-align: top;
      }
      .status-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .status-pending {
        background: #fff3cd;
        color: #856404;
      }
      .status-shipped {
        background: #d1fae5;
        color: #065f46;
      }
      .status-completed {
        background: #dbeafe;
        color: #1e40af;
      }
      .status-other {
        background: #f3f4f6;
        color: #374151;
      }
      .invoice-pending {
        color: #999;
        font-style: italic;
      }
      .footer {
        padding: 16px 32px;
        background-color: #f7f7f7;
        font-size: 11px;
        color: #aaa;
        border-top: 1px solid #e0e0e0;
      }
      .empty-state {
        padding: 32px;
        text-align: center;
        color: #999;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Resumen diario de facturas</h1>
        <p>Pedidos creados o enviados el {{date}}</p>
      </div>

      <div class="summary-bar">
        <div class="summary-item">
          <span class="summary-item-label">Pedidos creados</span>
          <span class="summary-item-value">{{total_orders}}</span>
        </div>
        <div class="summary-item">
          <span class="summary-item-label">Total neto</span>
          <span class="summary-item-value">{{gross_total}}</span>
        </div>
        <div class="summary-item">
          <span class="summary-item-label">Total neto</span>
          <span class="summary-item-value">{{net_total}}</span>
        </div>
      </div>

      <div class="content">
        {{#if has_rows}}
          <table>
            <thead>
              <tr>
                <th>Fecha</th>
                <th>#Pedido</th>
                <th>Estado</th>
                <th>Nº Factura</th>
                <th>Fecha Factura</th>
                <th>Total</th>
                <th>IVA</th>
                <th>Email cliente</th>
              </tr>
            </thead>
            <tbody>
              {{#each rows}}
                <tr>
                  <td>{{this.created_at}}</td>
                  <td>{{this.order_number}}</td>
                  <td>{{this.status_label}}</td>
                  <td>{{this.invoice_number}}</td>
                  <td>{{this.invoice_date}}</td>
                  <td>{{this.total}}</td>
                  <td>{{this.tax_total}}</td>
                  <td>{{this.customer_email}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <div class="empty-state">
            No hay pedidos para el
            {{date}}.
          </div>
        {{/if}}
      </div>

      <div class="footer">
        Generado automáticamente por Cartago4x4 · No responder a este mensaje
      </div>
    </div>
  </body>
</html>