<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmación de suscripción a producto</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
            line-height: 1.6;
            color: #333;
        }

        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-collapse: collapse;
        }

        /* Header */
        .header {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            padding: 30px 20px;
            text-align: center;
            border-bottom: 4px solid #e64a19;
        }

        .logo {
            max-width: 180px;
            height: auto;
            display: inline-block;
            margin-bottom: 15px;
        }

        .header h1 {
            color: #ffffff;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .header-subtitle {
            color: #e64a19;
            font-size: 14px;
            margin-top: 8px;
        }

        /* Main Content */
        .main-content {
            padding: 40px 30px;
        }

        .greeting {
            font-size: 16px;
            color: #1a1a1a;
            margin-bottom: 25px;
        }

        .alert-message {
            background-color: #f0f7ff;
            border-left: 4px solid #e64a19;
            padding: 20px;
            margin: 25px 0;
            border-radius: 4px;
        }

        .alert-message h2 {
            color: #e64a19;
            font-size: 18px;
            margin-bottom: 10px;
        }

        .alert-message p {
            color: #555;
            font-size: 14px;
            margin: 8px 0;
            line-height: 1.6;
        }

        .status-badge {
            display: inline-block;
            background-color: #e64a19;
            color: #ffffff;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 10px 0;
        }

        .status-badge.reactivated {
            background-color: #1976d2;
        }

        .product-card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 25px;
            margin: 30px 0;
            background-color: #fafafa;
            text-align: center;
        }

        .product-image {
            max-width: 200px;
            height: auto;
            border-radius: 8px;
            margin: 0 auto 20px;
            display: block;
        }

        .product-name {
            font-size: 18px;
            font-weight: 600;
            color: #1a1a1a;
            margin: 15px 0;
        }

        .product-sku {
            font-size: 12px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 10px 0;
        }

        .product-status {
            font-size: 14px;
            color: #e64a19;
            font-weight: 600;
            margin: 12px 0;
            padding: 12px;
            background-color: #fff3e0;
            border-radius: 4px;
        }

        .cta-button {
            display: inline-block;
            background-color: #e64a19;
            color: #ffffff;
            padding: 14px 40px;
            text-decoration: none;
            border-radius: 4px;
            font-weight: 600;
            font-size: 16px;
            margin-top: 20px;
            transition: background-color 0.3s ease;
        }

        .cta-button:hover {
            background-color: #d84315;
        }

        .info-items {
            background-color: #f5f5f5;
            padding: 25px;
            border-radius: 8px;
            margin: 25px 0;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 15px;
            font-size: 14px;
            color: #555;
        }

        .info-item:last-child {
            margin-bottom: 0;
        }

        .info-icon {
            color: #e64a19;
            font-size: 18px;
            margin-right: 12px;
            font-weight: 600;
        }

        .description {
            color: #666;
            font-size: 14px;
            line-height: 1.8;
            margin: 25px 0;
        }

        .divider {
            border-top: 2px solid #e0e0e0;
            margin: 30px 0;
        }

        /* Responsive */
        @media only screen and (max-width: 600px) {
            .email-container {
                width: 100% !important;
            }

            .main-content {
                padding: 25px 15px;
            }

            .info-items {
                padding: 15px;
            }

            .product-card {
                padding: 15px;
            }

            .header h1 {
                font-size: 22px;
            }

            .product-name {
                font-size: 16px;
            }

            .cta-button {
                width: 100%;
                display: block;
                padding: 16px 20px;
            }

            .footer {
                padding: 25px 15px;
            }

            .info-item {
                flex-direction: column;
            }

            .info-icon {
                margin-right: 0;
                margin-bottom: 5px;
            }
        }
    </style>
</head>

<body>
    <table class="email-container" width="100%" cellpadding="0" cellspacing="0">
        <!-- Header -->
        <tr>
            <td class="header">
                <img src="https://pub-9f70c8529e1d47ab90225640bcffecd9.r2.dev/logo_96x96.png?v=1767832537545&w=256&q=75"
                    alt="Cartago4x4" class="logo">
                <h1>{{#if is_new}}Nueva Suscripción{{else}}Suscripción Reactivada{{/if}}</h1>
                <div class="header-subtitle">Sistema de Alertas de Disponibilidad</div>
            </td>
        </tr>

        <!-- Main Content -->
        <tr>
            <td class="main-content">
                <div class="greeting">
                    <p>Hola,</p>
                </div>

                {{#if is_new}}
                <div class="alert-message">
                    <h2>✓ Suscripción registrada</h2>
                    <p><strong>{{subscriber_email}}</strong> se ha suscrito a las notificaciones de disponibilidad para
                        el siguiente producto.</p>
                    <span class="status-badge">Nueva suscripción</span>
                </div>
                {{else}}
                <div class="alert-message">
                    <h2>↻ Suscripción reactivada</h2>
                    <p><strong>{{subscriber_email}}</strong> ha reactivado su suscripción a las notificaciones de
                        disponibilidad.</p>
                    <span class="status-badge reactivated">Reactivada</span>
                </div>
                {{/if}}

                <div class="product-card">
                    {{#if image_url}}
                    <img src="{{image_url}}" alt="{{variant_title}}" class="product-image">
                    {{/if}}

                    <div class="product-name">{{variant_title}}</div>

                    {{#if product_sku}}
                    <div class="product-sku">SKU: {{product_sku}}</div>
                    {{/if}}

                    <div class="product-status">
                        ⚠️ Actualmente sin stock
                    </div>

                    <a href="{{product_url}}" class="cta-button">Ver producto</a>
                </div>

                <div class="divider"></div>

                <div class="info-items">
                    <div class="info-item">
                        <span class="info-icon">📧</span>
                        <div>
                            <strong>Email del suscriptor:</strong><br>
                            {{subscriber_email}}
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon">📦</span>
                        <div>
                            <strong>Producto:</strong><br>
                            {{variant_title}}
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-icon">🔔</span>
                        <div>
                            <strong>Estado:</strong><br>
                            {{#if is_new}}En espera de disponibilidad{{else}}Reactivada{{/if}}
                        </div>
                    </div>
                </div>
            </td>
        </tr>

        <!-- Footer -->
        {{> footer}}
    </table>
</body>

</html>